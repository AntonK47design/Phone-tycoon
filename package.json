    "sim:bot": "tsx scripts/sim-bot.ts"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/bungee": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@preact/signals": "2.11.3",
    "preact": "10.29.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
